# ReviewLens 全局忽略

# ---- 环境变量（含密钥）----
.env
.env.local
.env.*.local
!*.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*

# ---- Node ----
node_modules/
dist/
coverage/
*.local
*.tsbuildinfo

# ---- 模型产物 / 数据 ----
nlp/app/models/*
!nlp/app/models/.gitkeep
nlp/app/data/*.csv
nlp/app/data/*.jsonl

# ---- 工具数据 ----
.workbuddy/
.trae/
.zcode/

# ---- 原始数据集（过大，不入库）----
data/*.jsonl.gz
data/*.jsonl

# ---- IDE / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log