# ReviewLens 后端环境变量模板（复制为 .env 后填写）
# 数据库（PostgreSQL，Docker Compose 默认；宿主端口 15432 避开 Windows 保留段）
DATABASE_URL=postgresql+asyncpg://reviewlens:reviewlens_dev_only@localhost:15432/reviewlens

# JWT
JWT_SECRET_KEY=please_change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
REVIEWS_INDEX=reviews

# Redis（ARQ 队列 + 缓存）
REDIS_URL=redis://localhost:6379/0

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=reviewlens_admin
MINIO_SECRET_KEY=reviewlens_minio_dev_only
MINIO_BUCKET=reviewlens
MINIO_SECURE=false

# 数据导入
IMPORT_BATCH_SIZE=1000
MAX_REVIEW_TEXT_LENGTH=5000

# NLP 服务（注意：变量名为 NLP_BASE_URL，对应配置项 nlp_base_url）
NLP_BASE_URL=http://localhost:8100

# 登录/注册防爆破限流（可选）
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=30
AUTH_RATE_WINDOW_SECONDS=300
